# Copy to .env: `cp .env.example .env`. These values are good enough for a local docker compose run;
# replace every "change-me" before deploying anywhere else. .env is ignored by git.

DJANGO_DEBUG=False
# Port of the site (nginx) on the host: http://localhost:8080
WEB_PORT=8080
# HTTPS port, used only if client/certificates has localhost.pem and localhost-key.pem (mkcert)
WEB_HTTPS_PORT=8443

# One Django SECRET_KEY per service
SECRET_KEY_AUTH=change-me-auth-secret-key
SECRET_KEY_NEWS=change-me-news-secret-key
SECRET_KEY_SHOP=change-me-shop-secret-key
SECRET_KEY_MATCH=change-me-match-secret-key
SECRET_KEY_KOKOC_TEAM=change-me-kokoc-team-secret-key

# Shared by all services: tokens issued by auth are checked by the others
JWT_SIGNING_KEY=change-me-jwt-signing-key-at-least-32-characters

# Databases: one PostgreSQL per service. HOST/PORT are for running a service outside Docker;
# docker compose points every service at its own database container.
DATABASE_NAME_AUTH=kokoc_auth
DATABASE_USER_AUTH=kokoc
DATABASE_PASSWORD_AUTH=change-me
DATABASE_HOST_AUTH=localhost
DATABASE_PORT_AUTH=5432

DATABASE_NAME_NEWS=kokoc_news
DATABASE_USER_NEWS=kokoc
DATABASE_PASSWORD_NEWS=change-me
DATABASE_HOST_NEWS=localhost
DATABASE_PORT_NEWS=5432

DATABASE_NAME_SHOP=kokoc_shop
DATABASE_USER_SHOP=kokoc
DATABASE_PASSWORD_SHOP=change-me
DATABASE_HOST_SHOP=localhost
DATABASE_PORT_SHOP=5432

DATABASE_NAME_MATCH=kokoc_match
DATABASE_USER_MATCH=kokoc
DATABASE_PASSWORD_MATCH=change-me
DATABASE_HOST_MATCH=localhost
DATABASE_PORT_MATCH=5432

DATABASE_NAME_KOKOC_TEAM=kokoc_team
DATABASE_USER_KOKOC_TEAM=kokoc
DATABASE_PASSWORD_KOKOC_TEAM=change-me
DATABASE_HOST_KOKOC_TEAM=localhost
DATABASE_PORT_KOKOC_TEAM=5432

# Email with the sign-up code. Leave EMAIL_HOST_AUTH empty to print letters to the auth service log:
#   docker compose logs auth_microservice
EMAIL_HOST_AUTH=
EMAIL_PORT_AUTH=587
EMAIL_USE_TLS_AUTH=True
EMAIL_HOST_USER_AUTH=
EMAIL_HOST_PASSWORD_AUTH=
